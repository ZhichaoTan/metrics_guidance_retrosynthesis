+    def _mol_depth_within_limit(self, mol_node, max_depth):
+        if max_depth is None:
+            return True
+        return mol_node.depth < max_depth
+
+    def has_route_within_max_depth(self, max_depth):
+        if not self.succ:
+            return False
+        if max_depth is None:
+            return True
+
+        def dfs(mol_node):
+            if not self._mol_depth_within_limit(mol_node, max_depth):
+                return False
+            if mol_node.is_known:
+                return True
+            for reaction in mol_node.children:
+                if not reaction.succ:
+                    continue
+                if any(
+                    not self._mol_depth_within_limit(child, max_depth)
+                    for child in reaction.children
+                ):
+                    continue
+                if all(dfs(child) for child in reaction.children):
+                    return True
+            return False
+
+        return dfs(self.root)
+
+    def get_route_within_max_depth(self, max_depth):
+        if not self.succ:
+            return None
+        if max_depth is None:
+            return self.get_best_route()
+        if not self.has_route_within_max_depth(max_depth):
+            return None
+
+        syn_route = SynRoute(
+            target_mol=self.root.mol,
+            succ_value=self.root.succ_value,
+            search_status=self.search_status,
+        )
+
+        mol_queue = Queue()
+        mol_queue.put(self.root)
+        while not mol_queue.empty():
+            mol = mol_queue.get()
+            if not self._mol_depth_within_limit(mol, max_depth):
+                return None
+            if mol.is_known:
+                syn_route.set_value(mol.mol, mol.succ_value)
+                continue
+
+            best_reaction = None
+            for reaction in mol.children:
+                if not reaction.succ:
+                    continue
+                if any(
+                    not self._mol_depth_within_limit(child, max_depth)
+                    for child in reaction.children
+                ):
+                    continue
+                if (
+                    best_reaction is None
+                    or reaction.succ_value < best_reaction.succ_value
+                ):
+                    best_reaction = reaction
+            if best_reaction is None:
+                return None
+
+            reactants = []
+            for reactant in best_reaction.children:
+                mol_queue.put(reactant)
+                reactants.append(reactant.mol)
+
+            syn_route.add_reaction(
+                mol=mol.mol,
+                value=mol.succ_value,
+                template=best_reaction.template,
+                reactants=reactants,
+                cost=best_reaction.cost,
+            )
+
+        return syn_route
