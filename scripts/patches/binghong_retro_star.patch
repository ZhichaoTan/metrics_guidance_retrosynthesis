+import gzip
+import json
 import pickle
 import pandas as pd
 import logging
 from mlp_retrosyn.mlp_inference import MLPModel
 from retro_star.alg import molstar
 
+
+class StartingMoleculesContainer:
+    """Starting-molecule membership with exact and canonical lookup."""
+
+    def __init__(self, exact_smiles, canonical_smiles):
+        self._exact_smiles = set(exact_smiles)
+        self._canonical_smiles = set(canonical_smiles)
+
+    def __contains__(self, mol):
+        if mol in self._exact_smiles:
+            return True
+        try:
+            from rdkit import Chem
+            parsed = Chem.MolFromSmiles(mol)
+            if parsed is None:
+                return False
+            canonical = Chem.MolToSmiles(parsed, isomericSmiles=False)
+            return canonical in self._canonical_smiles
+        except Exception:
+            return False
+
+    def __len__(self):
+        return len(self._exact_smiles)
+
+
+def _prepare_starting_molecules_json_gz(filename):
+    exact_smiles = set()
+    canonical_smiles = set()
+    with gzip.open(filename, 'rt', encoding='utf-8') as handle:
+        buyables_list = json.load(handle)
+
+    from rdkit import Chem
+    for item in buyables_list:
+        smiles = item.get('smiles', '')
+        if not smiles:
+            continue
+        exact_smiles.add(smiles)
+        try:
+            mol = Chem.MolFromSmiles(smiles)
+            if mol is not None:
+                canonical_smiles.add(Chem.MolToSmiles(mol, isomericSmiles=False))
+        except Exception:
+            continue
+
+    return StartingMoleculesContainer(exact_smiles, canonical_smiles)
+
+
 def prepare_starting_molecules(filename):
     logging.info('Loading starting molecules from %s' % filename)
 
